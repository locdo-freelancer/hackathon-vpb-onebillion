{
  "name": "one-billion-backend",
  "version": "1.0.0",
  "description": "Backend API for One Billion application",
  "author": "Your Name",
  "private": true,
  "license": "MIT",
  "workspaces": {
    "packages": [
      "apps/*",
      "libs/*"
    ]
  },
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/apps/main/main",
    "start:dev": "npm run start --watch",
    "start:main": "nest start apps/main --watch",
    "start:ai-cron": "nest start apps/ai-cron --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/apps/one-billion-backend/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./apps/one-billion-backend/test/jest-e2e.json",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli",
    "migration:generate": "npm run typeorm -- -d ./apps/main/src/config/data-source.ts migration:generate ./apps/main/src/migrations/$npm_config_name",
    "migration:create": "npm run typeorm -- -d ./apps/main/src/config/data-source.ts migration:create ./apps/main/src/migrations/$npm_config_name",
    "migration:run": "npm run typeorm -- -d ./apps/main/src/config/data-source.ts  migration:run ",
    "migration:revert": "npm run typeorm -- -d ./apps/main/src/config/data-source.ts  migration:revert",
    "migration:show": "npm run typeorm -- -d ./apps/main/src/config/data-source.ts  migration:show"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.927.0",
    "@aws-sdk/client-eventbridge": "^3.927.0",
    "@aws-sdk/client-lambda": "^3.927.0",
    "@aws-sdk/client-s3": "^3.927.0",
    "@aws-sdk/client-secrets-manager": "^3.927.0",
    "@aws-sdk/client-sqs": "^3.927.0",
    "@google/generative-ai": "^0.24.1",
    "@nestjs/cache-manager": "^3.0.1",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mapped-types": "^2.0.4",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/schedule": "^4.0.0",
    "@nestjs/swagger": "^7.1.17",
    "@nestjs/typeorm": "^10.0.1",
    "bcrypt": "^5.1.1",
    "cache-manager-ioredis": "^2.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "ioredis": "^5.8.2",
    "passport": "^0.7.0",
    "passport-http-bearer": "^1.0.1",
    "passport-jwt": "^4.0.1",
    "pg": "^8.11.3",
    "redis": "^5.9.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "slugify": "^1.6.6",
    "socket.io": "^4.8.1",
    "typeorm": "^0.3.17",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.3.1",
    "@types/passport-http-bearer": "^1.0.41",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^2.0.12",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "testTimeout": 30000,
    "roots": [
      "<rootDir>/libs/",
      "<rootDir>/apps/"
    ],
    "moduleNameMapper": {
      "^@lib/guards(|/.*)$": "<rootDir>/libs/guards/src/$1",
      "^@lib/shared(|/.*)$": "<rootDir>/libs/shared/src/$1",
      "^@lib/entities(|/.*)$": "<rootDir>/libs/entities/$1",
      "^@lib/decorators(|/.*)$": "<rootDir>/libs/decorators/src/$1",
      "^@lib/middlewares(|/.*)$": "<rootDir>/libs/middlewares/src/$1",
      "^@lib/interceptors(|/.*)$": "<rootDir>/libs/interceptors/src/$1",
      "^@lib/constant(|/.*)$": "<rootDir>/libs/constant/src/$1",
      "^@lib/helper(|/.*)$": "<rootDir>/libs/helper/src/$1"
    }
  }
}
