{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "forceConsistentCasingInFileNames": false,
    "noFallthroughCasesInSwitch": false,
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@lib/guards": [
        "libs/guards/src"
      ],
      "@lib/guards/*": [
        "libs/guards/src/*"
      ],
      "@lib/shared": [
        "libs/shared/src"
      ],
      "@lib/shared/*": [
        "libs/shared/src/*"
      ],
      "@lib/entities": [
        "libs/entities"
      ],
      "@lib/entities/*": [
        "libs/entities/*"
      ],
      "@lib/decorators": [
        "libs/decorators/src"
      ],
      "@lib/decorators/*": [
        "libs/decorators/src/*"
      ],
      "@lib/middlewares": [
        "libs/middlewares/src"
      ],
      "@lib/middlewares/*": [
        "libs/middlewares/src/*"
      ],
      "@lib/interceptors": [
        "libs/interceptors/src"
      ],
      "@lib/interceptors/*": [
        "libs/interceptors/src/*"
      ],
      "@lib/constant": [
        "libs/constant/src"
      ],
      "@lib/constant/*": [
        "libs/constant/src/*"
      ],
      "@lib/helper": [
        "libs/helper/src"
      ],
      "@lib/helper/*": [
        "libs/helper/src/*"
      ]
    }
  }
}