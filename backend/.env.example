# ============================================================
# AWS SQS Configuration - Event & Message Queues
# ============================================================
# Main event queue for general system events
AWS_SQS_QUEUE_URL_EVENTS=https://sqs.ap-northeast-1.amazonaws.com/767049279728/securevault-events

# Notification delivery queue
AWS_SQS_QUEUE_URL_NOTIFICATIONS=https://sqs.ap-northeast-1.amazonaws.com/767049279728/securevault-notifications

# Threat enrichment processing queue
AWS_SQS_QUEUE_URL_ENRICHMENT=https://sqs.ap-northeast-1.amazonaws.com/767049279728/securevault-enrichment

# Log ingestion queue (from agents)
AWS_SQS_QUEUE_URL_LOG_INGESTION=https://sqs.ap-northeast-1.amazonaws.com/767049279728/securevault-log-ingestion

# Incident triage queue
AWS_SQS_QUEUE_URL_INCIDENT_TRIAGE=https://sqs.ap-northeast-1.amazonaws.com/767049279728/securevault-incident-triage

# ============================================================
# AWS S3 Configuration - Object Storage
# ============================================================
# Main bucket for general storage
AWS_S3_BUCKET_NAME=securevault-main-bucket

# Raw logs from agents (high-volume, lifecycle policy)
AWS_S3_BUCKET_LOGS=securevault-logs-bucket

# File attachments, scan results
AWS_S3_BUCKET_ATTACHMENTS=securevault-attachments-bucket

# AI analysis results (enrichment, decisions, predictions)
AWS_S3_BUCKET_AI_ANALYSIS=securevault-ai-analysis-bucket

AWS_S3_REGION=ap-northeast-1

# S3 Lifecycle configuration (optional)
AWS_S3_LOG_RETENTION_DAYS=90
AWS_S3_AI_ANALYSIS_RETENTION_DAYS=365

# CloudWatch Configuration
AWS_CLOUDWATCH_LOG_GROUP=/aws/lambda/securevault
AWS_CLOUDWATCH_NAMESPACE=SecureVault/Metrics

# AWS S3 Configuration
AWS_S3_BUCKET_NAME=securevault-main-bucket
AWS_S3_BUCKET_LOGS=securevault-logs-bucket
AWS_S3_BUCKET_ATTACHMENTS=securevault-attachments-bucket
AWS_S3_REGION=ap-northeast-1

# ============================================================
# AWS Lambda Configuration - Serverless Workers
# ============================================================
# Threat enrichment worker (calls VirusTotal, AbuseIPDB, etc.)
AWS_LAMBDA_ENRICHMENT_FUNCTION=securevault-enrichment-worker

# AI triage worker (GPT-based incident analysis)
AWS_LAMBDA_AI_TRIAGE_FUNCTION=securevault-ai-triage-worker

# Multi-channel notifier (Slack, Email, SMS)
AWS_LAMBDA_NOTIFIER_FUNCTION=securevault-notifier-worker

# Log parser worker (parse and normalize agent logs)
AWS_LAMBDA_LOG_PARSER_FUNCTION=securevault-log-parser-worker

# Decision execution worker (apply remediation actions)
AWS_LAMBDA_DECISION_EXECUTOR_FUNCTION=securevault-decision-executor-worker

# ============================================================
# AWS EventBridge Configuration - Event Orchestration
# ============================================================
# Custom event bus for SecureVault events
AWS_EVENTBRIDGE_BUS_NAME=securevault-event-bus

# Event source identifier
AWS_EVENTBRIDGE_SOURCE=securevault.system

# Rule prefixes (optional)
AWS_EVENTBRIDGE_RULE_PREFIX=securevault-

# ============================================================
# AWS Secrets Manager - Secure API Key Storage
# ============================================================
AWS_SECRETS_REGION=ap-northeast-1

# Secret names for external API keys
AWS_SECRET_VIRUSTOTAL_API=securevault/virustotal-api-key
AWS_SECRET_ABUSEIPDB_API=securevault/abuseipdb-api-key
AWS_SECRET_OPENAI_API=securevault/openai-api-key
AWS_SECRET_SLACK_WEBHOOK=securevault/slack-webhook-url
AWS_SECRET_SHODAN_API=securevault/shodan-api-key

# AI Service consolidated secrets (JSON format)
AWS_AI_SECRETS_NAME=onebillion/ai-api-keys


# ElastiCache Redis Configuration
REDIS_HOST=securevault-cache.vtzgzv.0001.apne1.cache.amazonaws.com
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL=3600

# Redis Feature Flags
REDIS_ENABLE_CACHING=true
REDIS_ENABLE_SESSION=true
REDIS_ENABLE_RATE_LIMITING=true

# Redis Connection Pool
REDIS_MAX_RETRIES=3
REDIS_RETRY_DELAY=1000
REDIS_CONNECT_TIMEOUT=10000

# External API Configuration (fallback if not using Secrets Manager)
VIRUSTOTAL_API_KEY=your-virustotal-api-key
ABUSEIPDB_API_KEY=your-abuseipdb-api-key
OPENAI_API_KEY=your-openai-api-key
SLACK_WEBHOOK_URL=your-slack-webhook-url

# ============================================================
# AI Service Configuration
# ============================================================

# AI Feature Flags
AI_ENABLE_THREAT_DETECTION=true
AI_ENABLE_ENRICHMENT=true
AI_ENABLE_DECISION_MAKING=true
AI_ENABLE_CHATOPS=true
AI_ENABLE_PREDICTIVE=false
AI_ENABLE_AUTO_REMEDIATION=false

# AI Processing Thresholds
AI_CONFIDENCE_THRESHOLD=0.8
AI_AUTO_EXECUTE_THRESHOLD=0.9

# AI LLM Provider Configuration (sẽ setup sau)
AI_OPENAI_API_KEY=your-openai-api-key-here
AI_OPENAI_MODEL=gpt-4
AI_AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AI_AZURE_OPENAI_API_KEY=your-azure-openai-key-here

# AI Threat Intelligence APIs (sẽ setup sau)
AI_VIRUSTOTAL_API_KEY=your-virustotal-api-key-here
AI_ABUSEIPDB_API_KEY=your-abuseipdb-api-key-here
AI_SHODAN_API_KEY=your-shodan-api-key-here

# AI Cache Configuration
AI_ENABLE_CACHING=true
AI_CACHE_TTL_SECONDS=3600

# AI SQS Queue URLs (sẽ setup sau)
AI_THREAT_DETECTION_QUEUE_URL=https://sqs.ap-northeast-1.amazonaws.com/767049279728/securevault-ai-detection
AI_ENRICHMENT_QUEUE_URL=https://sqs.ap-northeast-1.amazonaws.com/767049279728/securevault-ai-enrichment
